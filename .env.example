# PostgreSQL
POSTGRES_USER=streamvault
# Required. Use a strong value; never commit the populated .env file.
POSTGRES_PASSWORD=

# JWT (shared by gateway, user-service, and notification-service)
# Required, at least 32 bytes. JWT_EXPIRES_IN_MINUTES must be a positive integer.
JWT_SECRET=
JWT_EXPIRES_IN_MINUTES=60

# .NET service registration. Each port is used for ASP.NET listening, Consul,
# the Consul readiness URL, and the Compose health check.
USER_SERVICE_NAME=user-service
USER_SERVICE_PORT=8080
CATALOG_SERVICE_NAME=catalog-service
CATALOG_SERVICE_PORT=5100
SUBSCRIPTION_SERVICE_NAME=subscription-service
SUBSCRIPTION_SERVICE_PORT=5007

# Redis
REDIS_URL=redis://redis:6379/0

# Consul
CONSUL_ADDRESS=consul:8500

# RabbitMQ
# Required. Values are used both to seed a clean broker and by applications.
# Because credentials are embedded in AMQP URLs, use URL-safe characters.
RABBITMQ_USER=streamvault
RABBITMQ_PASS=

# Encoding: max retries means retries after the first attempt; 0 = one attempt.
# Max concurrent jobs must be between 1 and 65535.
ENCODING_MAX_RETRIES=3
ENCODING_MAX_CONCURRENT_JOBS=2

# Catalog database (canonical default; legacy installs can temporarily override).
CATALOG_DATABASE_NAME=streamvault_catalog

# MinIO
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=

# Elasticsearch
ELASTICSEARCH_URL=http://elasticsearch:9200

# Browser-visible build-time values. These are public and must never contain secrets.
NEXT_PUBLIC_API_URL=http://localhost:8081
NEXT_PUBLIC_WS_URL=ws://localhost:8081

# Grafana
GRAFANA_ADMIN_PASSWORD=
