  "Consul": {
    "Host": "http://localhost:8500",
    "ServiceName": "user-service",
    "ServiceId": "user-service-001",
    "ServicePort": 5100,
    "HealthCheckUrl": "http://localhost:5100/health",
    "HealthCheckIntervalSeconds": 10
  }
